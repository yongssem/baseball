# 뚝딱야구 환경변수 템플릿
# 실제 .env.local 파일을 만들고 아래 값을 채우세요. (절대 커밋 금지)

# ───────────────────────────────────────────
# Gemini API (서버리스 함수 전용 — 클라이언트 노출 금지)
# Vercel 대시보드 > Environment Variables 에 등록
# ───────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ───────────────────────────────────────────
# Firebase (클라이언트 공개 키 — VITE_ 프리픽스 필수)
# Firebase 콘솔 > 프로젝트 설정 > 웹 앱 SDK 구성 참고
# ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ───────────────────────────────────────────
# 비용 가드
# ───────────────────────────────────────────
DAILY_AI_LIMIT_PER_CLASS=200
