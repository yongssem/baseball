{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-quiz.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }]
}
